# dependencies
/node_modules

# build output (Vite) — this directory is what Firebase Hosting serves
/dist

# env files — copy .env.example and fill it in
.env
.env.*
!.env.example
# Production env IS committed: it holds no secrets (the Firebase web config is
# public by design and lives in the gitignored .env.local), and committing it is
# what stops a deploy from silently shipping the localhost API URL.
!.env.production

# firebase service-account key (secret — never commit; needed only by the
# School-bus-API repo, which has its own copy)
service-account.json

# test / coverage
/coverage

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# firebase / hosting
.firebase
firebase-debug.log
*-debug.log

# typescript
*.tsbuildinfo

# environment-local npm cache (scratch — never committed)
/.npm-cache

# local agent tooling (not part of the app)
/.agent

# local design-review harness (screenshots, preview)
/.taste-skill
