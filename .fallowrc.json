{
  // JSONC — fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Tailwind v4 is pulled in via `@import "tailwindcss"` in globals.css at
  // build time, and applied through the @tailwindcss/vite plugin — it is a
  // devDependency by design. Fonts are imported for their side-effect CSS in
  // main.tsx, which fallow cannot see.
  "ignoreDependencies": [
    "tailwindcss",
    "@tailwindcss/vite",
    "@fontsource-variable/inter",
    "@fontsource-variable/jetbrains-mono",
    "@fontsource/ibm-plex-sans-arabic"
  ],
  // i18n dictionary/type files intentionally re-export the same names
  // (Messages, messages) across modules — a namespace-barrel pattern.
  "ignoreExports": [
    {
      "file": "src/lib/i18n/dictionaries/en.ts",
      "exports": ["*"]
    },
    {
      "file": "src/lib/i18n/types.ts",
      "exports": ["*"]
    },
    {
      "file": "src/lib/i18n/dictionaries/ar.ts",
      "exports": ["*"]
    }
  ]
}
