# ── Firebase web app config ───────────────────────────────────────────────────
# These are PUBLIC client keys by design — the security model lives in Firestore
# security rules and the School-bus-API, not in hiding these values. Copy them
# from Firebase console → Project settings → Your apps → SDK setup and config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Backend ───────────────────────────────────────────────────────────────────
# Base URL of the School-bus-API server. Local dev default shown; in production
# this is the deployed API origin. The browser calls this cross-origin, so the
# API's APP_ORIGINS must list this app's origin.
VITE_API_URL=http://localhost:8080
