rules_version = '2';

// School Bus Transit — Firestore security rules.
//
// Access model: every user has a `users/{uid}` profile with `role` and
// `schoolId`. Three roles exist:
//
//   · **director** — full administration of their own school. Exactly one of
//     them carries `owner: true` (the "main director"); that flag is not read
//     here, because a director already holds everything these rules grant. It
//     is the API and the Operators page that use it to decide who may hand
//     access to other people.
//   · **operator** — office staff who sign in with email + password (the same
//     route as the director) and may open only the screens listed in their
//     profile's `screens` array. The client hides what they can't use; THESE
//     RULES are what makes that a permission rather than a hidden link, so the
//     list below is keyed by exactly the same screen names:
//     `live`, `students`, `reports`, `assignments`, `drivers`.
//   · **staff** — the driver/bus monitor on the phone, signing in with a 6-digit
//     access code. Writes only their own bus's runs/attendance.
//
// All data is scoped under `schools/{schoolId}`, so one school can never read
// another's data.
//
// A screen is a page, not a field: the dashboard screens share collections
// (Students and Reports both read attendance), so the `can*` helpers below
// describe which collection each screen needs and a read is granted to the
// union of the screens that need it. Writes are narrower than reads — an
// operator granted Assignments may change a student's `busId` and nothing else
// on the document.
//
// Profiles are created ONLY by Admin SDK code — scripts/seed.mjs, the API's
// `/v1/drivers` and `/v1/operators` routes — so a client can never self-create a
// profile or forge role/schoolId/owner/screens (the authorization gates
// everywhere below). Users read only their own profile (directors, and
// operators who need a staff list, additionally read their school's), update
// their own ONLY with those authorization fields unchanged, and never delete.
//
// Driver access codes live in `schools/{schoolId}/driverCodes/{driverUid}`,
// readable by that school's director and by an operator granted Drivers; the
// stored value is a hash. Code verification (login) is server-side via the
// Admin SDK, which bypasses these rules.
//
// Each school's `audit` subcollection is director-read-only. Entries are written
// by the Admin SDK (bypasses rules) and appended from the browser in the same
// batch as the change they describe — pinned to the caller, the server clock and
// a closed vocabulary, and never editable. Anyone authenticated but without a
// profile is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return userDoc().data;
    }

    function role() {
      return profile().get('role', '');
    }

    function screens() {
      return profile().get('screens', []);
    }

    function schoolId() {
      return profile().get('schoolId', '');
    }

    function isDirector() {
      return isSignedIn() && role() == 'director';
    }

    function isOperator() {
      return isSignedIn() && role() == 'operator';
    }

    function isStaff() {
      return isSignedIn() && role() == 'staff';
    }

    function isMySchool(schoolId) {
      return isSignedIn() && schoolId() == schoolId;
    }

    // ── screen capabilities ────────────────────────────────────────────────
    // A director holds every screen. An operator holds only what their profile
    // lists; `screens` defaults to [] so a malformed profile grants nothing.
    function can(screen) {
      return isDirector() || (isOperator() && screen in screens());
    }

    // ── collection capabilities, derived from the screens that need them ────
    // Live monitor / Students / Reports all read students, buses and run
    // records (the roster's summary and the live sheet both need them).
    function canSeeStudents() {
      return can('live') || can('students') || can('reports') || can('assignments');
    }

    // The Drivers page reads the bus list only to show which bus each driver
    // drives, so Drivers alone reaches buses but not students.
    function canSeeBuses() {
      return canSeeStudents() || can('drivers');
    }

    function canSeeRuns() {
      return can('live') || can('students') || can('reports');
    }

    function canWriteRuns() {
      return can('live') || can('students');
    }

    function canAssign() {
      return can('assignments');
    }

    // The pages that list staff names: Assignments (link a driver to a bus) and
    // Drivers (the access-code list).
    function canSeeTeam() {
      return can('assignments') || can('drivers');
    }

    // True when the caller is staff AND `busId` is the bus they drive
    // (buses/{id}.driverUid).
    function staffsOwnBus(busId) {
      return busId != null && isSignedIn() &&
        get(/databases/$(database)/documents/schools/$(schoolId())/buses/$(busId))
          .data.driverUid == request.auth.uid;
    }

    // ── provenance ─────────────────────────────────────────────────────────
    // Every write to a record the director can be asked about must say WHO made
    // it and WHEN, and the rules make that claim true: `updatedBy` is the
    // caller's uid and `updatedAt` is the server's clock, so neither can be
    // omitted, back-dated or attributed to somebody else. This is the half of
    // the activity log that cannot be skipped; the `audit` entry beside it is
    // the history. See docs/superpowers/specs/*-audit-log-design.md.
    function stamped() {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // ── the activity log's client half ─────────────────────────────────────
    // A browser may append an entry, and only in this shape: authored by the
    // caller, stamped with the server's clock, drawn from a closed vocabulary,
    // bounded, and expiring on its own. It can never claim another actor, be
    // back-dated, or be edited afterwards — those are the three properties that
    // make it worth reading. It cannot prove the change happened: the values are
    // what the writer said they were.
    function auditShapeOk() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'event', 'outcome', 'reason', 'at', 'occurredAt',
          'actorUid', 'actorRole', 'actorName', 'targetType', 'targetId',
          'targetName', 'changes', 'correlationId', 'meta', 'source', 'expiresAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.source == 'client'
        && request.resource.data.at == request.time
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.outcome in ['success', 'failure']
        && request.resource.data.expiresAt > request.time
        && request.resource.data.changes.keys().size() <= 8
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 80
        // `meta` is a closed set of scalars, because an open map on the log is
        // the dumping ground the reader must never have to defend against.
        && (!('meta' in request.resource.data)
          || request.resource.data.meta == null
          || request.resource.data.meta.keys()
            .hasOnly(['count', 'runId', 'date', 'busId', 'reason']));
    }

    // A driver appends only what a driver does. Office staff append the moves,
    // imports and settings they are allowed to make. Nobody appends account or
    // sign-in events — those belong to the API, which writes them itself.
    function auditEventAllowed() {
      return (
          (request.resource.data.event in ['attendance.changed', 'run.completed'])
          && (isStaff() || isOperator() || isDirector())
        ) || (
          (request.resource.data.event in [
            'student.bus_changed', 'student.updated', 'bus.driver_changed',
            'students.imported', 'run.dispatched',
            'school.assignment_mode_changed', 'activity.exported'
          ])
          && (isOperator() || isDirector())
        );
    }

    // ── users ──────────────────────────────────────────────────────────────
    // Profiles are created ONLY by Admin SDK code, so role/schoolId/owner/screens
    // can't be forged by a self-created profile. A user may read their own
    // profile; a director may read any profile of their own school, and an
    // operator may read the profiles of the pages that list staff. Everyone else
    // is denied, so a driver can never read another user's profile. A user may
    // update their own profile ONLY with those four fields unchanged — otherwise
    // an attacker could self-promote to director/operator or switch tenants.
    // Profiles are never deleted from a client.
    match /users/{uid} {
      allow read: if request.auth.uid == uid
        || (isSignedIn() && resource.data.schoolId == schoolId() && canSeeTeam());
      allow update: if request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.get('owner', false) == resource.data.get('owner', false)
        && request.resource.data.get('screens', []) == resource.data.get('screens', []);
      allow delete: if false;
    }

    // ── schools ────────────────────────────────────────────────────────────
    // The school document also carries `assignmentMode` ("bus" | "driver"), which
    // decides whether Assignments labels a row by bus or by driver. A director
    // may write it; so may an operator granted Assignments, and ONLY that field —
    // the diff check is what keeps a page grant from becoming a school rename.
    match /schools/{schoolId} {
      allow read: if isMySchool(schoolId);
      allow create, delete: if isMySchool(schoolId) && isDirector();
      allow update: if isMySchool(schoolId) && (
        isDirector()
        || (canAssign()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['assignmentMode', 'updatedBy', 'updatedAt']))
      ) && stamped();

      // Students & buses are school-administered. A secretary runs this school
      // day to day, so a grant is the authority: an operator granted Students
      // may ADD a child and correct one, exactly as a director may — that is
      // what the screen they were given is for — and the child they add carries
      // only the keys an import writes (`name`, `grade`, `busId`, both stamps),
      // because the sheet already decided the class and the bus. That bound
      // applies to every role, a director included: a create is the import's
      // shape, and a director who needs another field can set it in an update,
      // where their branch is unbounded. Deleting a
      // child stays director-only: nothing in the product offers it, and
      // "remove this person" is not an office task.
      //
      // Two separate grants, each with its own field list:
      //   - `students` may CREATE a child and correct NAME and GRADE (the
      //     roster is theirs to maintain);
      //   - `assignments` may change the BUS and nothing else.
      // A caller holding both gets the union — including both fields in ONE
      // write, which is what a sheet import does (a row carries a class and a
      // bus, and splitting it into two updates would need two batches for one
      // decision). Neither list is a subset of the other, so a grant can never
      // quietly grow into the other one.
      match /students/{studentId} {
        allow read: if isMySchool(schoolId) && canSeeStudents();
        allow create: if isMySchool(schoolId) && can('students')
          && request.resource.data.keys()
            .hasOnly(['name', 'grade', 'busId', 'updatedBy', 'updatedAt'])
          && stamped();
        allow delete: if isMySchool(schoolId) && isDirector();
        allow update: if isMySchool(schoolId) && (
          isDirector()
          || (isOperator() && can('students')
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'grade', 'updatedBy', 'updatedAt']))
          || (canAssign()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['busId', 'updatedBy', 'updatedAt']))
          || (can('students') && canAssign()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['grade', 'busId', 'updatedBy', 'updatedAt']))
        ) && stamped();
      }

      match /buses/{busId} {
        allow read: if isMySchool(schoolId) && canSeeBuses();
        allow create, delete: if isMySchool(schoolId) && isDirector();
        allow update: if isMySchool(schoolId) && (
          isDirector()
          || (canAssign()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['driverUid', 'driver', 'updatedBy', 'updatedAt']))
        ) && stamped();
      }

      // Driver access codes — one doc per driver (a `codeHash`, never the
      // plaintext code). Readable by the director and by an operator granted
      // Drivers, because the Drivers page shows which accounts have a code.
      // Writes stay director-only: the verify route (Admin SDK, bypasses rules)
      // creates and rotates them.
      match /driverCodes/{driverUid} {
        allow read: if isMySchool(schoolId) && (isDirector() || can('drivers'));
        allow write: if isMySchool(schoolId) && isDirector();
      }

      // Runs hold run metadata (bus, type, date, status). Office staff granted a
      // screen that records attendance may write them; a driver may only write
      // their own bus's, and only with valid status/run-type/date fields. On a
      // run that already exists a driver may change the status and the two
      // stamps and nothing else — the bus, the type and the date are what the
      // day was, and the completed run is the record the director reads.
      match /runs/{runId} {
        allow read: if isMySchool(schoolId) && canSeeRuns();
        allow create, update: if isMySchool(schoolId) && (
          isDirector()
          || (isOperator() && canWriteRuns())
          || (isStaff() &&
            staffsOwnBus(request.resource.data.busId) &&
            request.resource.data.status in ['IN_PROGRESS', 'COMPLETED'] &&
            request.resource.data.runType in ['morning', 'afternoon'] &&
            request.resource.data.date is string &&
            (resource == null
              || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedBy', 'updatedAt'])))
        ) && stamped();
        allow delete: if isMySchool(schoolId) && isDirector();
      }

      // Attendance is a flat per-school collection, one doc per (run, student) —
      // denormalized for single-query realtime reads. Same write shape as runs:
      // on a doc that already exists a driver records the status and its two
      // timestamps and nothing else, so `studentName`, `grade`, `busName` and
      // `date` stay the copies the sheet took at dispatch — the record a family
      // is shown later is not rewritable from a bus.
      match /attendance/{attId} {
        allow read: if isMySchool(schoolId) && canSeeRuns();
        allow create, update: if isMySchool(schoolId) && (
          isDirector()
          || (isOperator() && canWriteRuns())
          || (isStaff() &&
            staffsOwnBus(request.resource.data.busId) &&
            request.resource.data.status in ['BOARDED', 'WAITING', 'DROPPED_OFF', 'ABSENT'] &&
            (resource == null
              || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'boardedAt', 'droppedOffAt', 'updatedBy', 'updatedAt'])))
        ) && stamped();
        allow delete: if isMySchool(schoolId) && isDirector();
      }

      // The activity log. The API's Admin SDK writes here too and bypasses these
      // rules; a browser may only append, in the shape `auditShapeOk` pins down,
      // with an event its role is allowed to record. Nothing may be edited or
      // removed by anyone but the retention policy.
      match /audit/{entryId} {
        allow read: if isMySchool(schoolId) && isDirector();
        allow create: if isMySchool(schoolId) && auditShapeOk() && auditEventAllowed();
        allow update, delete: if false;
      }
    }
  }
}
